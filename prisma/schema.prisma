datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// --- ENUMS ---

enum PlanTier {
  FREE
  STARTER
  PRO
  PLUS
}

enum CreditTxType {
  PLAN_GRANT   // monthly allocation granted by the plan
  PURCHASE     // one-time credit pack bought via Stripe
  USAGE        // deducted when a feature is consumed
  ADMIN_ADJUST // manual grant or deduction by admin
  REFUND       // credits returned (e.g. failed generation)
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAUSED
  CANCELED
}

enum NodeRole {
  INPUT
  OUTPUT
  GROUP
}

enum NodeType {
  QUESTION
  IMAGE
  IMAGE_GEN
  VIDEO
  PDF
  CODE
  TEXT
  EMBED
  RESPONSE
  COMMENT
  NOTES
  NAPKIN
  NAPKIN_RESPONSE
  IMAGE_GEN_RESULT
  YOUTUBE_VID
}

enum EdgeType {
  MANUAL
  GENERATED
  REFERENCE
  PARENT_CHILD
}

enum ConversationStatus {
  PENDING
  STREAMING
  COMPLETED
  FAILED
}

enum PrePromptTemplateType {
  SYSTEM
  USER
  FEATURE
}

enum PaymentStatus {
  SUCCEEDED
  FAILED
  PENDING
  REFUNDED
}

enum CanvasRole {
  OWNER
  EDITOR
  COMMENTOR
  VIEWER
}

enum ShareStatus {
  ACTIVE
  PENDING
  REMOVED
}

// --- CORE MODELS ---

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  name     String?
  image    String?
  googleId String? @unique

  plan           PlanTier           @default(FREE)
  status         SubscriptionStatus @default(ACTIVE)
  stripeId       String?            @unique
  subscriptionId String?            @unique

  // Credit system: current spendable balance (in credits)
  creditBalance  Int                @default(0)

  // Free trial: when set, user gets trialTier features until trialEndsAt
  trialEndsAt DateTime?
  trialTier   PlanTier?

  sessions            Session[]
  canvases            Canvas[]
  canvasShares        CanvasShare[]
  usageLogs           UsageLog[]
  creditTransactions  CreditTransaction[]
  prePromptTemplates  PrePromptTemplate[]
  attachments         Attachment[]
  documents           Document[]
  payments            Payment[]
  bugReports          BugReport[]
  comments            Comment[]      @relation("CommentAuthor")
  commentReplies      CommentReply[] @relation("CommentReplyAuthor")

  // Email/password auth fields (null for Google-only users)
  passwordHash      String?
  emailVerified     Boolean   @default(false)
  verifyToken       String?   @unique
  verifyTokenExpiry DateTime?

  // Password reset (1-hour token, cleared on use)
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
  @@index([googleId])
  @@index([plan])
  @@map("users")
}

model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token String @unique // opaque UUID refresh token

  expiresAt         DateTime // sliding window — reset on each rotation
  absoluteExpiresAt DateTime // hard cap — never changes after creation

  isRevoked  Boolean  @default(false)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model Canvas {
  id          String  @id @default(uuid())
  name        String
  description String?

  boundsMinX Float @default(0)
  boundsMinY Float @default(0)
  boundsMaxX Float @default(0)
  boundsMaxY Float @default(0)

  viewportX    Float?
  viewportY    Float?
  viewportZoom Float? @default(1)

  nodeCount Int @default(0)
  edgeCount Int @default(0)

  isPublic Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  nodes         Node[]
  edges         Edge[]
  snapshots     CanvasSnapshot[]
  conversations AIConversation[]
  shares        CanvasShare[]
  comments      Comment[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, updatedAt(sort: Desc)])
  @@index([isPublic])
  @@map("canvases")
}

model Node {
  id       String @id @default(uuid())
  canvasId String
  canvas   Canvas @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  clientId String? // Frontend ID for idempotent sync (e.g. "1709123456789")

  x      Float
  y      Float
  width  Float @default(360)
  height Float @default(240)
  zIndex Int   @default(0)

  // Bounding box for spatial queries (computed from x,y,width,height)
  bboxMinX Float?
  bboxMinY Float?
  bboxMaxX Float?
  bboxMaxY Float?
  tileIds  Int[] @default([])

  role     NodeRole @default(INPUT)
  nodeType NodeType

  title    String? @db.VarChar(512)

  content  Json @default("{}")
  metadata Json @default("{}")
  style    Json @default("{}")

  parentNodeId String?
  parent       Node?   @relation("NodeTree", fields: [parentNodeId], references: [id], onDelete: SetNull)
  children     Node[]  @relation("NodeTree")

  isLocked    Boolean @default(false)
  isCollapsed Boolean @default(false)

  conversations AIConversation[]

  outgoingEdges Edge[] @relation("EdgeSource")
  incomingEdges Edge[] @relation("EdgeTarget")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([canvasId, clientId])
  @@index([canvasId, role])
  @@index([canvasId, nodeType])
  @@index([canvasId, bboxMinX, bboxMaxX, bboxMinY, bboxMaxY])
  @@index([parentNodeId])
  @@map("nodes")
}

model Edge {
  id       String @id @default(uuid())
  canvasId String
  canvas   Canvas @relation(fields: [canvasId], references: [id], onDelete: Cascade)

  sourceNodeId String
  sourceNode   Node   @relation("EdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)

  targetNodeId String
  targetNode   Node   @relation("EdgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)

  edgeType EdgeType @default(MANUAL)

  metadata Json @default("{}")
  style    Json @default("{}")

  createdAt DateTime @default(now())

  @@unique([canvasId, sourceNodeId, targetNodeId, edgeType])
  @@index([canvasId])
  @@index([sourceNodeId, targetNodeId])
  @@map("edges")
}

// Figma-style spatial canvas comments. A comment is a pin anchored at (x, y)
// in canvas coordinates; replies thread under it. `resolved` toggles open ↔ done.
// Soft-delete via `deletedAt` so we keep an audit trail and can offer undo later.
model Comment {
  id       String @id @default(uuid())
  canvasId String
  canvas   Canvas @relation(fields: [canvasId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  body String @db.Text

  // Anchor position in canvas coordinates (NOT screen coordinates).
  // PeerOverlay-style transforms project these to screen on render.
  x Float
  y Float

  // Optional: bind the pin to a node so it follows when the node is moved.
  // We don't enforce this in the MVP, but keeping the field reserves the slot.
  anchorNodeId String?

  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  resolvedBy String?

  deletedAt DateTime?

  replies   CommentReply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([canvasId, resolved, deletedAt])
  @@index([authorId])
  @@map("comments")
}

model CommentReply {
  id        String  @id @default(uuid())
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("CommentReplyAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  body String @db.Text

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([commentId, createdAt])
  @@map("comment_replies")
}

model CanvasShare {
  id        String      @id @default(uuid())
  canvasId  String
  userId    String
  role      CanvasRole  @default(EDITOR)
  status    ShareStatus @default(PENDING)

  invitedBy  String?
  invitedAt  DateTime    @default(now())
  acceptedAt DateTime?

  canvas Canvas @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([canvasId, userId])
  @@index([userId])
  @@index([canvasId])
  @@map("canvas_shares")
}

// --- AI & ANALYTICS ---

model AIConversation {
  id       String @id @default(uuid())
  nodeId   String
  canvasId String

  node   Node   @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  canvas Canvas @relation(fields: [canvasId], references: [id], onDelete: Cascade)

  prompt       String  @db.Text
  systemPrompt String? @db.Text
  model        String  @db.VarChar(100)

  response String? @db.Text

  tokensPrompt   Int?
  tokensResponse Int?
  tokensTotal    Int?
  costUsd        Decimal? @db.Decimal(10, 6)

  latencyMs Int?

  status       ConversationStatus @default(PENDING)
  errorMessage String?            @db.Text

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([nodeId, createdAt(sort: Desc)])
  @@index([canvasId, createdAt(sort: Desc)])
  @@index([status])
  @@map("ai_conversations")
}

model CanvasSnapshot {
  id       String @id @default(uuid())
  canvasId String
  canvas   Canvas @relation(fields: [canvasId], references: [id], onDelete: Cascade)

  snapshotData Json
  nodeCount    Int

  createdBy   String
  description String?

  createdAt DateTime @default(now())

  @@index([canvasId, createdAt(sort: Desc)])
  @@map("canvas_snapshots")
}

model UsageLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  resourceType String
  quantity     Int      @default(1)
  tokensUsed   Int?
  creditsUsed  Int?     // credits deducted for this action (null = pre-credit-system)
  costUsd      Decimal? @db.Decimal(10, 6)

  metadata Json @default("{}")

  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([resourceType, createdAt(sort: Desc)])
  @@map("usage_logs")
}

// Immutable ledger — every credit movement is recorded here.
// amount: positive = added, negative = deducted.
// balance: snapshot of creditBalance AFTER this transaction (for audit replay).
model CreditTransaction {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount  Int            // positive = credit added, negative = credit deducted
  balance Int            // user's creditBalance after this transaction
  type    CreditTxType
  reason  String         // e.g. "monthly_plan_grant", "video_gen:kling-v3:5s:std"

  resourceType String?   // matches RESOURCE_TYPES constant — set for USAGE transactions
  usageLogId   String?   // optional FK to UsageLog for full traceability

  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@map("credit_transactions")
}

model PrePromptTemplate {
  id        String                @id @default(uuid())
  name      String                @db.VarChar(255)
  prompt    String                @db.Text
  type      PrePromptTemplateType  @default(SYSTEM)
  userId    String?
  user      User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([userId])
  @@map("pre_prompt_templates")
}

// --- ATTACHMENTS (S3-backed file storage) ---

enum AttachmentType {
  IMAGE
  PDF
  CSV
  OTHER
}

model Attachment {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  key       String         @unique // S3 object key
  filename  String         // Original filename
  mimeType  String
  sizeBytes Int
  type      AttachmentType

  entityType  String?  // e.g. "canvas", "node" - for polymorphic association
  entityId    String?  // e.g. canvasId, nodeId

  // Gallery publishing
  isPublic    Boolean   @default(false)
  publishedAt DateTime?
  title       String?   // Optional caption shown in gallery
  prompt      String?   // AI prompt used (for display context)
  likesCount  Int       @default(0)
  viewsCount  Int       @default(0)

  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([type])
  @@index([isPublic, createdAt(sort: Desc)])
  @@map("attachments")
}

// --- DOCUMENTS (RAG Pipeline) ---

enum DocumentType {
  PDF
  CSV
  IMAGE
}

enum DocumentStatus {
  PENDING
  PROCESSING
  CHUNKING
  EMBEDDING
  COMPLETED
  FAILED
}

enum ChunkingStrategy {
  FIXED_SIZE
  SEMANTIC
  CSV_ROW
  PAGE
}

model Document {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  canvasId String?  // null = uploaded outside canvas context

  // File info
  filename     String
  s3Key        String         @unique
  mimeType     String
  sizeBytes    Int
  documentType DocumentType
  contentHash  String?        // SHA-256 for deduplication (set after upload)

  // Processing state
  status          DocumentStatus @default(PENDING)
  errorMessage    String?
  processingJobId String?        // BullMQ job ID for idempotency

  // Extracted metadata (populated by workers)
  pageCount     Int?
  rowCount      Int?
  extractedText String?        @db.Text  // First 50 KB preview
  ocrConfidence Float?

  // Relations
  chunks   DocumentChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, canvasId, status])
  @@index([contentHash])
  @@map("documents")
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // Chunk data
  chunkIndex Int     // Order within document
  content    String  @db.Text
  tokenCount Int
  charCount  Int

  // Source location
  pageNumber Int?    // For PDFs
  rowRange   String? // For CSVs: "1-20"

  // Chunking metadata
  strategy ChunkingStrategy

  // Embedding relation
  embedding ChunkEmbedding?

  createdAt DateTime @default(now())

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@map("document_chunks")
}

model ChunkEmbedding {
  id      String        @id @default(uuid())
  chunkId String        @unique
  chunk   DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  // pgvector column — HNSW allows max 2000 dims; we use MRL outputDimensionality 1536
  embedding Unsupported("vector(1536)")
  model     String       @default("gemini-embedding-001")

  createdAt DateTime @default(now())

  @@index([chunkId])
  @@map("chunk_embeddings")
}

// --- ADMIN: Plan overrides (admin panel can override static plan-config.ts) ---

// Admin-controlled app-wide settings (key/value store)
model AppConfig {
  key       String   @id           // e.g. 'default_trial_days'
  value     String                 // stored as string, parsed by consumer
  updatedAt DateTime @updatedAt

  @@map("app_config")
}

model PlanFeatureOverride {
  id        String   @id @default(uuid())
  tier      PlanTier
  feature   String   // matches FeatureKey (e.g. 'collaboration', 'imageGeneration')
  enabled   Boolean
  updatedAt DateTime @updatedAt
  updatedBy String?  // admin note

  @@unique([tier, feature])
  @@index([tier])
  @@map("plan_feature_overrides")
}

model PlanLimitOverride {
  id        String   @id @default(uuid())
  tier      PlanTier
  limitKey  String   // matches limit field name (e.g. 'maxProjects', 'maxAiTokensPerMonth')
  value     Int      // -1 = unlimited
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([tier, limitKey])
  @@index([tier])
  @@map("plan_limit_overrides")
}

model RAGQuery {
  id       String  @id @default(uuid())
  userId   String
  canvasId String? // Optional link to canvas context

  query             String   @db.Text
  retrievedChunkIds String[] // Chunk IDs used for context
  contextText       String?  @db.Text  // Assembled context (for debugging)
  response          String   @db.Text

  provider         String   @default("gemini")
  model            String   @default("gemini-2.0-flash-lite")
  retrievalTimeMs  Int
  generationTimeMs Int

  documentIds String[]  // Documents queried (stored as plain array for query performance)

  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([canvasId])
  @@map("rag_queries")
}

// --- PAYMENTS (Stripe webhook-persisted transactions) ---

model Payment {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeInvoiceId String? @unique // Stripe invoice ID (idempotency key)
  stripeChargeId  String? // Stripe charge ID

  plan        PlanTier      @default(FREE)
  amountCents Int           // amount in cents (e.g. 1399 = $13.99)
  currency    String        @default("usd")
  status      PaymentStatus

  periodStart DateTime? // subscription billing period start
  periodEnd   DateTime? // subscription billing period end

  invoiceUrl String? // Stripe hosted invoice URL
  invoicePdf String? // Stripe invoice PDF URL

  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("payments")
}

// --- BUG REPORTS ---

enum BugReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model BugReport {
  id            String          @id @default(uuid())
  userId        String?
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  description   String          @db.Text
  screenshotKey  String?         // S3 key (legacy single screenshot — kept for existing data)
  screenshotKeys String[]        // S3 keys for multiple screenshots

  status        BugReportStatus @default(OPEN)

  userEmail     String?         // Cached at submission time
  userName      String?         // Cached at submission time

  adminNote     String?         @db.Text

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([userId])
  @@map("bug_reports")
}

// --- WEBHOOK LOGS (persistent audit trail for every Stripe event) ---

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  SKIPPED
}

model WebhookLog {
  id        String             @id @default(uuid())
  eventId   String             @unique // Stripe event ID — prevents duplicate processing
  eventType String
  status    WebhookEventStatus @default(RECEIVED)
  error     String?            @db.Text // full error message if processing failed
  userId    String?            // resolved userId if applicable
  payload   Json               // full Stripe event payload for replay/debug

  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([eventType])
  @@index([status])
  @@map("webhook_logs")
}
