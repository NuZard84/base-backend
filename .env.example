# APPLICATION CONFIGURATION

NODE_ENV=development
PORT=3000


# Redis (optional REDIS_USERNAME for Redis Cloud / ACL default user)
REDIS_PASSWORD=your_pass
REDIS_HOST=your_host
REDIS_PORT=your_port
# REDIS_USERNAME=default

# DATABASE CONFIGURATION
# The backend automatically selects the correct database URL based on NODE_ENV:
# - NODE_ENV=development  → uses DATABASE_URL_DEV
# - NODE_ENV=production   → uses DATABASE_URL_PROD

# Development database URL (for local development)
DATABASE_URL_DEV=postgresql://username:password@localhost:5432/notifier_db_dev

# Production database URL (set via CI/CD secrets in GitHub Actions)
# ⚠️  DO NOT commit production credentials to git - use GitHub Actions secrets instead
# DATABASE_URL_PROD=postgresql://username:password@prod-host:5432/notifier_db_prod

# JWT AUTHENTICATION
# Secret key for signing JWT tokens (use a strong, random string)
JWT_SECRET=your-super-secret-jwt-key-here

# Token expiration times (in seconds)
EXPIRE_ACCESS_TOKEN=10800   # 3 hours
EXPIRE_REFRESH_TOKEN=2592000 # 30 days

# GOOGLE OAUTH CONFIGURATION
# Get these from Google Cloud Console
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional: Custom callback URL (defaults to http://localhost:3000/api/auth/callback/google)
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/callback/google

# CORS CONFIGURATION
# Comma-separated list of allowed frontend URLs
# Example: http://localhost:3000,https://yourdomain.com
FRONTEND_URL=http://localhost:3000

# Add these as you implement more OAuth providers

# GitHub OAuth (if implemented)
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# Slack OAuth (if implemented)
# SLACK_CLIENT_ID=your-slack-client-id
# SLACK_CLIENT_SECRET=your-slack-client-secret


AWS_S3_ACCESS_KEY=your-aws-s3-access-key
AWS_S3_SECRET_KEY=your-aws-s3-secret-key
AWS_S3_REGION=your-aws-s3-region
AWS_S3_BUCKET=your-aws-s3-bucket